# Copy to .env.development and fill in.
#
# VITE_API_BASE_URL — the backend root. No trailing slash.
#   Local dev backend example:  http://localhost:3000
#   POC VM example:             http://10.210.12.12:3000
#
# VITE_USE_MOCKS — 'true' to run against MSW, 'false' to run against VITE_API_BASE_URL.

VITE_API_BASE_URL=http://10.210.12.12:3000
VITE_USE_MOCKS=false
